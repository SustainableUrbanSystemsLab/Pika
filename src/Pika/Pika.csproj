<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Pika</AssemblyName>
    <RootNamespace>PlugInSolar</RootNamespace>
    <Version>0.5.0</Version>
    <TargetExt>.gha</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RhinoDir Condition="'$(RhinoDir)'==''">/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources</RhinoDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- 8.27 is the oldest supported Rhino; the Yak tag (rh8_27) is taken from the RhinoCommon referenced here. -->
    <PackageReference Include="RhinoCommon" Version="8.27.26019.16021" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.27.26019.16021" ExcludeAssets="runtime" />
    <Reference Include="System.Windows.Forms"><HintPath>$(RhinoDir)/System.Windows.Forms.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Drawing.Common"><HintPath>$(RhinoDir)/System.Drawing.Common.dll</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="Assets/*-24.png" />
    <None Include="../../python/bridge.py" Link="bridge.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../python/solar_conditions.py" Link="solar_conditions.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
